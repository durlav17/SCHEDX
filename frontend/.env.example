# Copy to .env.local for local overrides, or set in Netlify (Site configuration > Environment variables).
# Leave EMPTY for local development: requests use relative /api paths and the Vite dev server proxies them to localhost:8000.
# For the Netlify build, set it to the public address of the Render backend (no trailing /api needed):
#   VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com
# This value is compiled into the public JavaScript bundle. Never put a secret here.
VITE_API_BASE_URL=
