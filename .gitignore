npm-debug.log*
.npm/

# ---- Logs and OS / editor files
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# NOT ignored on purpose: research-results/ (protocol, raw CSV/JSON, charts, summary), docs/,
# frontend/public/research/ (website copy of the charts and results table) and
# frontend/src/lib/__fixtures__/ (golden fixture shared by the Python and TypeScript decoders).

